class Queue:
    def __init__(self):
        self.stack_1 = []  # Primary stack for enqueue operations
        self.stack_2 = []  # Secondary stack for dequeue/peek operations

    def enq(self, a):
        # Push the element onto stack_1 (enqueue operation)
        self.stack_1.append(a)

    def deq(self):
        # If both stacks are empty, return -1 (this case won't occur based on constraints)
        if len(self.stack_1) == 0 and len(self.stack_2) == 0:
            return -1
        
        # If stack_2 is empty, transfer all elements from stack_1 to stack_2
        if len(self.stack_2) == 0:
            while len(self.stack_1) != 0:
                self.stack_2.append(self.stack_1.pop())
        
        # Pop the top element from stack_2 (dequeue operation)
        return self.stack_2.pop()

    def peek(self):
        # If both stacks are empty, return -1 (this case won't occur based on constraints)
        if len(self.stack_1) == 0 and len(self.stack_2) == 0:
            return -1

        # If stack_2 is empty, transfer all elements from stack_1 to stack_2
        if len(self.stack_2) == 0:
            while len(self.stack_1) != 0:
                self.stack_2.append(self.stack_1.pop())

        # Return the top element of stack_2 (front of the queue)
        return self.stack_2[-1]


if __name__ == '__main__':
    import sys
    input = sys.stdin.read
    data = input().splitlines()

    # Number of queries
    q = int(data[0])

    # Initialize the queue
    Q = Queue()

    # Process each query
    results = []
    for i in range(1, q + 1):
        query = data[i].split()
        if query[0] == '1':  # Enqueue operation
            Q.enq(int(query[1]))
        elif query[0] == '2':  # Dequeue operation
            Q.deq()
        elif query[0] == '3':  # Peek operation
            results.append(Q.peek())

    # Output results for query type 3
    print("\n".join(map(str, results)))
